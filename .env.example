# Copiez ce fichier en .env — ne commitez jamais .env !
#
# GH_TOKEN : publication des Releases (electron-builder --publish always).
#            Scope : repo (classic) ou fine-grained Contents + Releases (write).
#
# GH_UPDATE_TOKEN : PAT read-only embarqué dans l'installateur (repo privé).
#                   Fine-grained recommandé : Contents: Read sur Android-Hub uniquement.
GH_TOKEN=ghp_votre_token_publish_ici
GH_UPDATE_TOKEN=ghp_votre_token_read_only_ici
